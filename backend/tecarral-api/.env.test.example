PORT=3001

DB_HOST=localhost
DB_PORT=5432
DB_NAME=tecarral_test
DB_USER=your_db_user
DB_PASSWORD=your_db_password

JWT_SECRET=your_test_jwt_secret
JWT_EXPIRES_IN=8h

JWT_ISSUER=jwt_issuer_example-api_test
JWT_AUDIENCE=jwt_audience_example-app_test

EXPIRE_JOB_ENABLED=false
EXPIRE_JOB_LIMIT=1000

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false

SMTP_USER=test@example.com
SMTP_PASS=test_password

PUBLIC_BASE_URL=http://localhost:3001

MAIL_FROM_NAME=Tecarral Test
MAIL_FROM_EMAIL=test@example.com
SIGNED_ALBARAN_INTERNAL_EMAIL=internal@example.com
SIGNED_REPAIR_BUDGET_INTERNAL_EMAIL=internal@example.com
SIGNED_SERVICE_CONTRACT_INTERNAL_EMAIL=internal@example.com
LIBREOFFICE_BIN=soffice

# Local: uploads dentro del backend. Oracle: usa una ruta persistente de la VM, por ejemplo /opt/tecarral/uploads.
MACHINE_UPLOADS_DIR=

